<Grid x:Name="Root" Background="#C40A0C12"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="Card" Width="520" Height="340" CornerRadius="24"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid Margin="40,30,40,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="150" Height="150" VerticalAlignment="Center">
                <Ellipse Width="150" Height="150" Stroke="{DynamicResource TrackBrush}" StrokeThickness="8" />
                <Path x:Name="ProgressArc" Stroke="{DynamicResource EyeBrush}" StrokeThickness="8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="20" FontSize="44" FontFamily="Segoe UI Variable Display"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="秒" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                <TextBlock x:Name="TitleText" Text="目光移向 6 米外" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" TextWrapping="Wrap" />
                <TextBlock x:Name="SubText" Text="放松睫状肌，眨眨眼" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                           FontFamily="Microsoft YaHei UI" Margin="0,8,0,0" />
                <TextBlock x:Name="HintText" Text="休息结束后自动继续护眼计时" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           FontFamily="Microsoft YaHei UI" Margin="0,14,0,0" />
                <Button x:Name="SkipButton" Style="{DynamicResource SecondaryButtonStyle}" Content="跳过休息" FontSize="13" Height="36"
                        Margin="0,20,0,0" HorizontalAlignment="Left" IsEnabled="False" />
                <TextBlock x:Name="SkipHintText" Text="5 秒后可跳过" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           FontFamily="Microsoft YaHei UI" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
