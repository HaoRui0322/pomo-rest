<Grid x:Name="Root" Background="Transparent"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="ShadowLayer" Margin="16" CornerRadius="28" Background="#66000000">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.55" Color="#000000" />
        </Border.Effect>
    </Border>

    <Border x:Name="Card" Margin="16" CornerRadius="28"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid x:Name="Header" Height="32" Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="22" Height="22">
                        <Ellipse Width="18" Height="18" Fill="{DynamicResource TomatoBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        <Path Data="M 0,7 L 4,0 L 8,7 Z" Fill="{DynamicResource EyeBrush}" Width="8" Height="7" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock x:Name="TitleText" Text="番茄小憩" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="已暂停" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Microsoft YaHei UI" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PinButton" Style="{DynamicResource IconButtonStyle}" Content="&#xE718;" ToolTip="窗口置顶" />
                    <Button x:Name="CompactButton" Style="{DynamicResource IconButtonStyle}" Content="&#xE73F;" ToolTip="紧凑模式" />
                    <Button x:Name="SettingsButton" Style="{DynamicResource IconButtonStyle}" Content="&#xE713;" ToolTip="设置" />
                    <Button x:Name="HideButton" Style="{DynamicResource IconButtonStyle}" Content="&#xE8BB;" ToolTip="隐藏到托盘" />
                </StackPanel>
            </Grid>

            <!-- Mode switch -->
            <Grid x:Name="ModeSwitch" Grid.Row="1" Height="38" Margin="0,0,0,14">
                <Border CornerRadius="19" Background="{DynamicResource TrackBrush}" Padding="3">
                    <Grid>
                        <Border x:Name="ModeIndicator" Width="120" Height="32" CornerRadius="16"
                                Background="{DynamicResource TomatoBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PomodoroTab" Grid.Column="0" Style="{DynamicResource SegmentedButtonStyle}" Content="番茄钟" />
                            <Button x:Name="EyeTab" Grid.Column="1" Style="{DynamicResource SegmentedButtonStyle}" Content="护眼提醒" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Main view -->
            <Grid x:Name="MainView" Grid.Row="2" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="RingArea" Grid.Row="0" Width="196" Height="196" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Ellipse Width="196" Height="196" Stroke="{DynamicResource TrackBrush}" StrokeThickness="10" />
                    <Path x:Name="ProgressArc" Stroke="{DynamicResource TomatoBrush}" StrokeThickness="10"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="PhaseLabel" Text="专注" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TimeText" Text="25:00" FontSize="46" FontFamily="Segoe UI Variable Display"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock x:Name="SubStatusText" Text="" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="DotsPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Ellipse x:Name="Dot0" Width="8" Height="8" Fill="{DynamicResource TomatoBrush}" Margin="0,0,7,0" />
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="{DynamicResource TomatoBrush}" Margin="0,0,7,0" />
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="{DynamicResource TomatoBrush}" Margin="0,0,7,0" />
                    <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="{DynamicResource TomatoBrush}" />
                </StackPanel>
                <TextBlock x:Name="EyeInfoText" Grid.Row="1" Text="每 20 分钟 · 远眺 20 秒"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}" FontFamily="Microsoft YaHei UI"
                           HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed" />

                <Button x:Name="NoteButton" Grid.Row="2" Style="{DynamicResource QuietButtonStyle}" Height="34" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock x:Name="NoteLabel" Text="  添加本次备注" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Microsoft YaHei UI" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button x:Name="ResetButton" Style="{DynamicResource SecondaryButtonStyle}" Content="重置" Height="38" Margin="0,0,8,0" />
                    <Button x:Name="PrimaryButton" Style="{DynamicResource PrimaryButtonStyle}" Content="开始" Width="112" Height="44" Margin="0,0,8,0" />
                    <Button x:Name="SkipButton" Style="{DynamicResource SecondaryButtonStyle}" Content="跳过" Height="38" />
                </StackPanel>
            </Grid>

            <!-- History view -->
            <Grid x:Name="HistoryView" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="HistoryBackButton" Style="{DynamicResource QuietButtonStyle}" Content="‹ 返回" FontSize="13" />
                    <TextBlock Text="历史记录" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               FontFamily="Microsoft YaHei UI" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="HistorySummaryText" Grid.Row="1" Text="" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           FontFamily="Microsoft YaHei UI" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="HistoryList" />
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="ExportDetailButton" Style="{DynamicResource SecondaryButtonStyle}" Content="导出明细 CSV" FontSize="12" Height="32" />
                    <Button x:Name="ExportSummaryButton" Style="{DynamicResource SecondaryButtonStyle}" Content="导出汇总 CSV" FontSize="12" Height="32" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- Settings view -->
            <Grid x:Name="SettingsView" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="SettingsBackButton" Style="{DynamicResource QuietButtonStyle}" Content="‹ 返回" FontSize="13" />
                    <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               FontFamily="Microsoft YaHei UI" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="SettingsStack" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="ResetDefaultsButton" Style="{DynamicResource SecondaryButtonStyle}" Content="恢复默认" FontSize="12" Height="32" />
                    <Button x:Name="ExitButton" Style="{DynamicResource SecondaryButtonStyle}" Content="退出应用" FontSize="12" Height="32" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid x:Name="Footer" Grid.Row="3" Height="34" Margin="0,10,0,0">
                <Button x:Name="StatsButton" Style="{DynamicResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatsText" Grid.Column="0" Text="今日 0 轮 · 0 分钟 · 护眼 0 次" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Microsoft YaHei UI" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="记录 ›" FontSize="12" Foreground="{DynamicResource EyeBrush}" FontFamily="Microsoft YaHei UI"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Note editor overlay -->
            <Grid x:Name="NoteOverlay" Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
                <Border CornerRadius="16" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" Margin="6" Padding="16,14" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="本次专注备注" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" />
                        <TextBox x:Name="NoteBox" Style="{DynamicResource TextBoxStyle}" Height="88" MaxLength="200"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" />
                        <TextBlock x:Name="NoteCount" Text="0 / 200" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Microsoft YaHei UI" HorizontalAlignment="Right" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="NoteCancelButton" Style="{DynamicResource SecondaryButtonStyle}" Content="取消" FontSize="12" Height="32" Margin="0,0,8,0" />
                            <Button x:Name="NoteSaveButton" Style="{DynamicResource PrimaryButtonStyle}" Content="保存" FontSize="12" Width="72" Height="32" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Compact view -->
            <Grid x:Name="CompactView" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="52" Height="52" VerticalAlignment="Center">
                    <Ellipse Width="52" Height="52" Stroke="{DynamicResource TrackBrush}" StrokeThickness="6" />
                    <Path x:Name="CompactArc" Stroke="{DynamicResource TomatoBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="CompactTime" Text="25:00" FontSize="22" FontFamily="Segoe UI Variable Display"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="CompactStatus" Text="已暂停 · 专注" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Microsoft YaHei UI" />
                </StackPanel>
                <Button x:Name="CompactPrimaryButton" Grid.Column="2" Style="{DynamicResource PrimaryButtonStyle}"
                        Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Width="40" Height="40" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Grid>
